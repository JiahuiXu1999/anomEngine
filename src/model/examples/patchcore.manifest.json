{
  "schema_version": 1,
  "model": {
    "id": "bottle-patchcore",
    "version": "1.0.0",
    "algorithm": "patchcore"
  },
  "graph_contract": "feature_pyramid",
  "input": {
    "tensor": "input",
    "layout": "NCHW",
    "color": "RGB",
    "resize": [256, 256],
    "center_crop": [224, 224],
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "runtime": {
    "onnx": "backbone.onnx",
    "engine": "cache/backbone.engine",
    "load_policy": "prefer_engine",
    "fp16": false,
    "max_batch_size": 4,
    "workspace_mb": 2048
  },
  "outputs": {
    "layer2": "layer2",
    "layer3": "layer3"
  },
  "algorithm": {
    "type": "patchcore",
    "index": "memory_bank.faiss",
    "feature_layers": ["layer2", "layer3"],
    "embedding_dimension": 1536,
    "num_neighbors": 9,
    "pooling_kernel": 3,
    "pooling_stride": 1,
    "pooling_padding": 1,
    "sqrt_distances": true,
    "weighted_image_score": true,
    "gaussian_sigma": 4.0
  },
  "postprocess": {
    "normalize": true,
    "threshold": true,
    "image_threshold": 0.42,
    "pixel_threshold": 0.37,
    "image_min": 0.08,
    "image_max": 1.73,
    "pixel_min": 0.01,
    "pixel_max": 2.21,
    "image_sensitivity": 0.5,
    "pixel_sensitivity": 0.5
  }
}
