{
  "schema_version": 1,
  "model": {
    "id": "bottle-padim",
    "version": "1.0.0",
    "algorithm": "padim"
  },
  "graph_contract": "feature_pyramid",
  "input": {
    "tensor": "input",
    "layout": "NCHW",
    "color": "RGB",
    "size": [224, 224],
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "runtime": {
    "onnx": "backbone.onnx",
    "engine": "cache/backbone.engine",
    "load_policy": "prefer_engine",
    "fp16": false,
    "max_batch_size": 4,
    "workspace_mb": 2048
  },
  "outputs": {
    "layer1": "layer1",
    "layer2": "layer2",
    "layer3": "layer3"
  },
  "algorithm": {
    "type": "padim",
    "statistics": "gaussian_statistics.bin",
    "channel_indices": "channel_indices.i32",
    "feature_layers": ["layer1", "layer2", "layer3"],
    "embedding_dimension": 100,
    "feature_map_size": [56, 56],
    "gaussian_sigma": 4.0
  },
  "postprocess": {
    "normalize": true,
    "threshold": true,
    "image_threshold": 12.5,
    "pixel_threshold": 8.3,
    "image_min": 2.0,
    "image_max": 24.0,
    "pixel_min": 0.2,
    "pixel_max": 18.0,
    "image_sensitivity": 0.5,
    "pixel_sensitivity": 0.5
  }
}
